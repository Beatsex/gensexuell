<?xml version="1.0" encoding="utf-8"?>
<!-- Installer window for gensexuell on macOS; build-pkg.sh fills in @VERSION@ and packs it with productbuild.
     Titles and descriptions are keys into en.lproj / de.lproj/Localizable.strings. -->
<installer-gui-script minSpecVersion="2">
    <title>SU_TITLE</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="app"/>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="clap"/>
        <line choice="lv2"/>
        <line choice="docs"/>
    </choices-outline>

    <choice id="app" title="APP_TITLE" description="APP_DESC">
        <pkg-ref id="com.beatsexuell.gensexuell.app"/>
    </choice>
    <choice id="vst3" title="VST3_TITLE" description="VST3_DESC">
        <pkg-ref id="com.beatsexuell.gensexuell.vst3"/>
    </choice>
    <choice id="au" title="AU_TITLE" description="AU_DESC">
        <pkg-ref id="com.beatsexuell.gensexuell.au"/>
    </choice>
    <choice id="clap" title="CLAP_TITLE" description="CLAP_DESC">
        <pkg-ref id="com.beatsexuell.gensexuell.clap"/>
    </choice>
    <choice id="lv2" title="LV2_TITLE" description="LV2_DESC">
        <pkg-ref id="com.beatsexuell.gensexuell.lv2"/>
    </choice>
    <!-- always installed: manual, licenses, source (AGPL) and the uninstaller -->
    <choice id="docs" title="DOCS_TITLE" description="DOCS_DESC" enabled="false" selected="true">
        <pkg-ref id="com.beatsexuell.gensexuell.docs"/>
    </choice>

    <pkg-ref id="com.beatsexuell.gensexuell.app" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
    <pkg-ref id="com.beatsexuell.gensexuell.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.beatsexuell.gensexuell.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.beatsexuell.gensexuell.clap" version="@VERSION@" onConclusion="none">clap.pkg</pkg-ref>
    <pkg-ref id="com.beatsexuell.gensexuell.lv2" version="@VERSION@" onConclusion="none">lv2.pkg</pkg-ref>
    <pkg-ref id="com.beatsexuell.gensexuell.docs" version="@VERSION@" onConclusion="none">docs.pkg</pkg-ref>
</installer-gui-script>
